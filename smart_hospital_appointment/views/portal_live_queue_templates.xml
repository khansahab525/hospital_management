<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_hospital_appointment_live" name="Hospital live queue dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Live Queue</t>
            </t>
            <t t-set="doctor" t-value="appointment.doctor_id"/>
            <t t-set="initials" t-value="''.join([part[0].upper() for part in (doctor.name or '').split()[:2] if part])"/>
            <div class="container pb-5 o_live_queue" t-att-data-url="live_data_url" data-status="loading">
                <section class="o_lq_hero o_lq_reveal">
                    <span class="o_lq_blob o_lq_blob_1"/>
                    <span class="o_lq_blob o_lq_blob_2"/>
                    <span class="o_lq_blob o_lq_blob_3"/>
                    <div class="o_lq_hero_inner">
                        <div class="o_lq_doctor">
                            <div class="o_lq_avatar">
                                <img t-if="doctor.image"
                                     t-attf-src="/web/image/hospital.doctor/#{doctor.id}/image/160x160"
                                     t-att-alt="doctor.name"/>
                                <span t-else="" t-out="initials"/>
                            </div>
                            <div>
                                <span class="o_lq_live_pill">
                                    <span class="o_lq_live_dot"/>
                                    LIVE
                                </span>
                                <h1 class="o_lq_doctor_name">Dr. <t t-out="doctor.name"/></h1>
                                <p class="o_lq_doctor_spec" t-if="doctor.specialization" t-out="doctor.specialization.name"/>
                                <div class="o_lq_chips">
                                    <span class="o_lq_chip">
                                        <i class="fa fa-map-marker" aria-hidden="true"/>
                                        <t t-out="appointment.branch_id.name"/>
                                    </span>
                                    <span class="o_lq_chip">
                                        <i class="fa fa-calendar" aria-hidden="true"/>
                                        <span t-field="appointment.appointment_datetime" t-options="{'widget': 'date'}"/>
                                    </span>
                                    <span class="o_lq_chip">
                                        <i class="fa fa-ticket" aria-hidden="true"/>
                                        <t t-out="appointment.name"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="o_lq_hero_side">
                            <a t-attf-href="/my/hospital/appointment/#{appointment.id}" class="o_lq_back_btn">
                                <i class="fa fa-arrow-left" aria-hidden="true"/>
                                Back to appointment
                            </a>
                            <div class="o_lq_sync">
                                <i class="fa fa-refresh" aria-hidden="true"/>
                                Updated <span class="o_live_updated">--:--:--</span>
                            </div>
                        </div>
                    </div>
                    <div class="o_lq_refresh_track"><span class="o_lq_refresh_bar"/></div>
                </section>

                <section class="o_lq_turn_banner" role="status">
                    <span class="o_lq_turn_icon"><i class="fa fa-bell" aria-hidden="true"/></span>
                    <div>
                        <strong>It's your turn!</strong>
                        <span>Please proceed to Dr. <t t-out="doctor.name"/>'s room.</span>
                    </div>
                </section>

                <section class="o_lq_stats">
                    <article class="o_lq_stat o_lq_stat_mine o_lq_reveal">
                        <div class="o_lq_stat_head">
                            <span class="o_lq_stat_icon"><i class="fa fa-user" aria-hidden="true"/></span>
                            <span class="o_lq_stat_label">Your Number</span>
                        </div>
                        <div class="o_lq_stat_value" data-field="my_number">-</div>
                        <span class="o_lq_status_pill" data-field="my_hint">Loading…</span>
                    </article>
                    <article class="o_lq_stat o_lq_stat_serving o_lq_reveal">
                        <div class="o_lq_stat_head">
                            <span class="o_lq_stat_icon"><i class="fa fa-stethoscope" aria-hidden="true"/></span>
                            <span class="o_lq_stat_label">Now Serving</span>
                        </div>
                        <div class="o_lq_stat_value" data-field="now_serving">-</div>
                        <div class="o_lq_stat_hint">
                            <span class="o_lq_wave" aria-hidden="true"><i/><i/><i/><i/></span>
                            <span data-field="serving_hint"/>
                        </div>
                    </article>
                    <article class="o_lq_stat o_lq_stat_ahead o_lq_reveal">
                        <div class="o_lq_stat_head">
                            <span class="o_lq_stat_icon"><i class="fa fa-users" aria-hidden="true"/></span>
                            <span class="o_lq_stat_label">Patients Ahead</span>
                        </div>
                        <div class="o_lq_stat_value" data-field="ahead">-</div>
                        <div class="o_lq_stat_hint">
                            <i class="fa fa-clock-o" aria-hidden="true"/>
                            <span data-field="wait_hint"/>
                        </div>
                    </article>
                </section>

                <section class="o_lq_panel o_lq_reveal">
                    <div class="o_lq_panel_head">
                        <div>
                            <h3>Today's Queue</h3>
                            <p class="o_lq_panel_sub"><span data-field="progress_text">-</span></p>
                        </div>
                        <div class="o_lq_legend">
                            <span class="o_lq_lg o_s_upcoming"><i/>Upcoming</span>
                            <span class="o_lq_lg o_s_in_progress"><i/>In Consultation</span>
                            <span class="o_lq_lg o_s_completed"><i/>Completed</span>
                            <span class="o_lq_lg o_s_cancelled"><i/>Cancelled</span>
                        </div>
                    </div>
                    <div class="o_lq_progress"><span class="o_lq_progress_bar"/></div>
                    <div class="o_live_grid">
                        <div class="o_lq_skeleton"/>
                        <div class="o_lq_skeleton"/>
                        <div class="o_lq_skeleton"/>
                        <div class="o_lq_skeleton"/>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
