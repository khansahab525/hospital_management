<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_home_slider_kanban" model="ir.ui.view">
        <field name="name">hospital.home.slider.kanban</field>
        <field name="model">hospital.home.slider</field>
        <field name="arch" type="xml">
            <kanban default_order="sequence, id" records_draggable="1">
                <field name="id"/>
                <field name="sequence"/>
                <field name="active"/>
                <field name="media_type"/>
                <field name="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-0 overflow-hidden">
                            <div class="position-relative">
                                <img t-if="record.image.raw_value" t-att-src="kanban_image('hospital.home.slider', 'image', record.id.raw_value)"
                                     alt="Slide" class="w-100" style="height: 150px; object-fit: cover;"/>
                                <div t-else="" class="d-flex align-items-center justify-content-center text-white"
                                     style="height: 150px; background: linear-gradient(135deg, #0b1f4d, #4f46e5);">
                                    <i class="fa fa-film fa-3x opacity-75" aria-hidden="true"/>
                                </div>
                                <span t-if="record.media_type.raw_value == 'video'" class="badge text-bg-dark position-absolute top-0 end-0 m-2">
                                    <i class="fa fa-play me-1" aria-hidden="true"/>Video
                                </span>
                            </div>
                            <div class="p-3">
                                <strong class="d-block"><field name="name"/></strong>
                                <div class="text-muted small text-truncate"><field name="title"/></div>
                                <span t-if="!record.active.raw_value" class="badge text-bg-secondary mt-2">Hidden</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hospital_home_slider_tree" model="ir.ui.view">
        <field name="name">hospital.home.slider.tree</field>
        <field name="model">hospital.home.slider</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [96, 40]}"/>
                <field name="name"/>
                <field name="media_type" widget="badge" decoration-info="media_type == 'video'"/>
                <field name="title"/>
                <field name="caption_align"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_hospital_home_slider_form" model="ir.ui.view">
        <field name="name">hospital.home.slider.form</field>
        <field name="model">hospital.home.slider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Hidden" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Summer check-up campaign"/></h1>
                    </div>
                    <group>
                        <group string="Media">
                            <field name="media_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="video_source" widget="radio" options="{'horizontal': true}"
                                   invisible="media_type != 'video'" required="media_type == 'video'"/>
                            <field name="video_filename" invisible="1"/>
                            <field name="video_file" filename="video_filename"
                                   options="{'accepted_file_extensions': '.mp4,.m4v,.mov,.webm,.ogg,.ogv'}"
                                   invisible="media_type != 'video' or video_source != 'upload'"
                                   required="media_type == 'video' and video_source == 'upload'"/>
                            <field name="video_url" placeholder="https://www.youtube.com/watch?v=..."
                                   invisible="media_type != 'video' or video_source != 'url'"
                                   required="media_type == 'video' and video_source == 'url'"/>
                            <div colspan="2" class="text-muted small" invisible="media_type != 'video'">
                                Videos play muted and loop in the background. Use a short, compressed MP4 (under 20 MB)
                                or a YouTube / Vimeo link. The image below is shown while the video loads.
                            </div>
                        </group>
                        <group string="Image">
                            <field name="image" widget="image" nolabel="1" colspan="2" class="w-100"
                                   options="{'size': [0, 200]}" required="media_type == 'image'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Caption">
                            <field name="badge" placeholder="e.g. 24/7 Emergency"/>
                            <field name="title" placeholder="e.g. Expert care, close to home"/>
                            <field name="subtitle" placeholder="Short supporting sentence"/>
                            <field name="caption_align" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group string="Buttons">
                            <field name="button_text" placeholder="e.g. Book Appointment"/>
                            <field name="button_url"/>
                            <field name="button_text_2" placeholder="e.g. Find a Doctor"/>
                            <field name="button_url_2"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_home_slider_search" model="ir.ui.view">
        <field name="name">hospital.home.slider.search</field>
        <field name="model">hospital.home.slider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <filter name="image_slides" string="Images" domain="[('media_type', '=', 'image')]"/>
                <filter name="video_slides" string="Videos" domain="[('media_type', '=', 'video')]"/>
                <separator/>
                <filter name="inactive" string="Hidden" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hospital_home_slider" model="ir.actions.act_window">
        <field name="name">Website Slider</field>
        <field name="res_model">hospital.home.slider</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first home page slide</p>
            <p>Upload a wide image (about 1920 × 800 px) or a background video, with an optional heading and buttons.
                Active slides rotate in the slider at the top of the website home page.</p>
        </field>
    </record>

    <menuitem id="menu_hospital_home_slider" name="Website Slider" parent="menu_hospital_masters"
              action="action_hospital_home_slider" sequence="21"
              groups="smart_hospital_appointment.group_hospital_admin,base.group_system"/>
</odoo>
