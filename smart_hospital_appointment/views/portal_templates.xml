<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_hospital" inherit_id="portal.portal_my_home" name="Portal My Home: Hospital">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Book Appointment</t>
                <t t-set="url" t-value="'/appointment/book'"/>
                <t t-set="text">Book and manage your appointments</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_home_menu_hospital" inherit_id="portal.portal_breadcrumbs" name="Portal breadcrumbs: Hospital">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name and page_name in ('hospital', 'hospital_new', 'hospital_edit', 'hospital_detail')" t-attf-class="breadcrumb-item #{'active' if page_name == 'hospital' else ''}">
                <a t-if="page_name != 'hospital'" href="/my/hospital">Hospital</a>
                <t t-else="">Hospital</t>
            </li>
            <li t-if="page_name == 'hospital_new'" class="breadcrumb-item active">New appointment</li>
            <li t-if="page_name == 'hospital_edit'" class="breadcrumb-item active">Edit appointment</li>
            <li t-if="page_name == 'hospital_detail'" class="breadcrumb-item active">Appointment</li>
        </xpath>
    </template>

    <template id="portal_appointment_status_badge" name="Appointment status badge">
        <t t-set="status_class" t-value="'o_status_' + appointment.state"/>
        <span t-attf-class="o_appt_status #{status_class}">
            <i class="fa fa-circle" style="font-size: 0.45rem;" aria-hidden="true"/>
            <span t-field="appointment.state"/>
        </span>
    </template>

    <template id="portal_my_hospital" name="Hospital portal dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Hospital appointments</t>
            </t>
            <div class="container pb-5 o_hospital_appointments_page">
                <section class="o_appt_hero">
                    <div class="o_appt_hero_inner">
                        <div>
                            <span class="o_appt_hero_badge">
                                <i class="fa fa-calendar-check-o" aria-hidden="true"/>
                                Your healthcare appointments
                            </span>
                            <h1 class="o_appt_hero_title">My Appointments</h1>
                            <p class="o_appt_hero_subtitle">
                                Track your visits, queue position, and estimated wait time. Book a new appointment anytime.
                            </p>
                        </div>
                        <div class="o_appt_hero_actions">
                            <a href="/appointment/book" class="o_appt_btn_primary">
                                <i class="fa fa-plus" aria-hidden="true"/>
                                New Appointment
                            </a>
                            <a href="/doctors" class="o_appt_btn_light">
                                <i class="fa fa-user-md" aria-hidden="true"/>
                                Browse Doctors
                            </a>
                        </div>
                    </div>
                </section>

                <section class="o_appt_stats">
                    <div class="row g-3">
                        <div class="col-6 col-lg">
                            <a href="/my/hospital?filterby=upcoming" t-attf-class="o_appt_stat_card o_stat_upcoming #{'active' if filterby == 'upcoming' else ''}">
                                <div class="o_appt_stat_icon">
                                    <i class="fa fa-clock-o" aria-hidden="true"/>
                                </div>
                                <div>
                                    <div class="o_appt_stat_value" t-out="upcoming_count"/>
                                    <p class="o_appt_stat_label">Upcoming</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-6 col-lg">
                            <a href="/my/hospital?filterby=completed" t-attf-class="o_appt_stat_card o_stat_completed #{'active' if filterby == 'completed' else ''}">
                                <div class="o_appt_stat_icon">
                                    <i class="fa fa-check-circle" aria-hidden="true"/>
                                </div>
                                <div>
                                    <div class="o_appt_stat_value" t-out="completed_count"/>
                                    <p class="o_appt_stat_label">Completed</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-6 col-lg">
                            <a href="/my/hospital?filterby=cancelled" t-attf-class="o_appt_stat_card o_stat_cancelled #{'active' if filterby == 'cancelled' else ''}">
                                <div class="o_appt_stat_icon">
                                    <i class="fa fa-times-circle" aria-hidden="true"/>
                                </div>
                                <div>
                                    <div class="o_appt_stat_value" t-out="cancelled_count"/>
                                    <p class="o_appt_stat_label">Cancelled</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-6 col-lg">
                            <a href="/my/hospital?filterby=all" t-attf-class="o_appt_stat_card o_stat_all #{'active' if filterby == 'all' else ''}">
                                <div class="o_appt_stat_icon">
                                    <i class="fa fa-list-alt" aria-hidden="true"/>
                                </div>
                                <div>
                                    <div class="o_appt_stat_value" t-out="appointment_count"/>
                                    <p class="o_appt_stat_label">Total Appointments</p>
                                </div>
                            </a>
                        </div>
                    </div>
                </section>

                <t t-if="not appointments">
                    <div class="o_appt_empty">
                        <i class="fa fa-calendar-times-o" aria-hidden="true"/>
                        <h3 t-if="filterby == 'all'">No appointments yet</h3>
                        <h3 t-else="">No appointments in this filter</h3>
                        <p t-if="filterby == 'all'">Book your first visit with one of our specialists.</p>
                        <p t-else="">Try another status or book a new appointment.</p>
                        <a href="/appointment/book" class="o_appt_action_btn o_btn_primary">
                            <i class="fa fa-plus" aria-hidden="true"/>
                            Book Appointment
                        </a>
                    </div>
                </t>

                <section t-if="appointments">
                    <t t-foreach="appointments" t-as="a">
                        <article t-attf-class="o_appt_card o_appt_card_#{a.state}">
                            <div class="o_appt_card_top">
                                <a t-attf-href="/my/hospital/appointment/#{a.id}" class="o_appt_ref" t-out="a.name"/>
                                <t t-set="appointment" t-value="a"/>
                                <span class="d-inline-flex gap-2 flex-wrap">
                                    <t t-call="smart_hospital_appointment.portal_appointment_status_badge"/>
                                    <t t-call="smart_hospital_appointment.portal_appointment_payment_badge"/>
                                </span>
                            </div>
                            <div class="o_appt_meta_grid">
                                <div class="o_appt_meta_item">
                                    <span class="o_appt_meta_icon"><i class="fa fa-calendar" aria-hidden="true"/></span>
                                    <span>
                                        <span class="o_appt_meta_label">Date &amp; Time</span>
                                        <span t-field="a.appointment_datetime"/>
                                    </span>
                                </div>
                                <div class="o_appt_meta_item">
                                    <span class="o_appt_meta_icon"><i class="fa fa-user-md" aria-hidden="true"/></span>
                                    <span>
                                        <span class="o_appt_meta_label">Doctor</span>
                                        <span t-field="a.doctor_id.name"/>
                                    </span>
                                </div>
                                <div class="o_appt_meta_item">
                                    <span class="o_appt_meta_icon"><i class="fa fa-hospital-o" aria-hidden="true"/></span>
                                    <span>
                                        <span class="o_appt_meta_label">Branch</span>
                                        <span t-field="a.branch_id.name"/>
                                    </span>
                                </div>
                                <div class="o_appt_meta_item">
                                    <span class="o_appt_meta_icon"><i class="fa fa-sort-numeric-asc" aria-hidden="true"/></span>
                                    <span>
                                        <span class="o_appt_meta_label">Token</span>
                                        <t t-if="a.token_number">#<t t-out="a.token_number"/></t>
                                        <t t-else="">-</t>
                                    </span>
                                </div>
                                <div class="o_appt_meta_item" t-if="a.expected_turn_datetime">
                                    <span class="o_appt_meta_icon"><i class="fa fa-hourglass-half" aria-hidden="true"/></span>
                                    <span>
                                        <span class="o_appt_meta_label">Est. with doctor</span>
                                        <span t-field="a.expected_turn_datetime"/>
                                    </span>
                                </div>
                                <div class="o_appt_meta_item">
                                    <span class="o_appt_meta_icon"><i class="fa fa-users" aria-hidden="true"/></span>
                                    <span>
                                        <span class="o_appt_meta_label">Released today</span>
                                        <t t-out="a.portal_released_today_count"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_appt_card_footer">
                                <a t-if="a._has_to_be_paid()" t-attf-href="/my/hospital/appointment/#{a.id}/pay" class="o_appt_action_btn o_btn_success me-2">
                                    <i class="fa fa-credit-card" aria-hidden="true"/>
                                    Pay Now
                                </a>
                                <a t-attf-href="/my/hospital/appointment/#{a.id}" class="o_appt_open_btn">
                                    View Details
                                    <i class="fa fa-arrow-right" aria-hidden="true"/>
                                </a>
                            </div>
                        </article>
                    </t>
                </section>

                <div t-if="pager" class="o_portal_pager d-flex justify-content-center my-4">
                    <t t-call="portal.pager"/>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_hospital_appointment_detail" name="Hospital portal appointment detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Appointment</t>
            </t>
            <t t-set="doctor" t-value="appointment.doctor_id"/>
            <t t-set="help_company" t-value="website.company_id.sudo()"/>
            <t t-set="state_order" t-value="{'draft': 0, 'confirmed': 1, 'in_progress': 2, 'completed': 3, 'released': 3}"/>
            <t t-set="current_step" t-value="state_order.get(appointment.state, -1)"/>
            <t t-set="timeline" t-value="[
                ('fa-pencil-square-o', 'Booked', 'Request received'),
                ('fa-check', 'Confirmed', 'Slot reserved for you'),
                ('fa-stethoscope', 'With Doctor', 'Consultation in progress'),
                ('fa-heart', 'Completed', 'Visit finished'),
            ]"/>
            <div t-attf-class="container pb-5 o_hospital_appointments_page o_appt_view o_appt_view_#{appointment.state}">

                <!-- Ticket header -->
                <section class="o_av_ticket">
                    <span class="o_av_glow o_av_glow_1"/>
                    <span class="o_av_glow o_av_glow_2"/>
                    <div class="o_av_ticket_main">
                        <span class="o_av_kicker"><i class="fa fa-calendar-check-o" aria-hidden="true"/> Appointment</span>
                        <h1 class="o_av_ref" t-out="appointment.name"/>
                        <div class="o_av_badges">
                            <t t-call="smart_hospital_appointment.portal_appointment_status_badge"/>
                            <t t-call="smart_hospital_appointment.portal_appointment_payment_badge"/>
                        </div>
                        <ul class="o_av_quick list-unstyled">
                            <li>
                                <i class="fa fa-calendar" aria-hidden="true"/>
                                <span t-field="appointment.appointment_datetime" t-options="{'widget': 'date'}"/>
                            </li>
                            <li t-if="doctor_hours_display">
                                <i class="fa fa-clock-o" aria-hidden="true"/>
                                <t t-out="doctor_hours_display"/>
                            </li>
                            <li t-if="appointment.branch_id">
                                <i class="fa fa-map-marker" aria-hidden="true"/>
                                <t t-out="appointment.branch_id.name"/>
                            </li>
                        </ul>
                    </div>
                    <div class="o_av_stub">
                        <span class="o_av_stub_label">Your Token</span>
                        <span class="o_av_stub_number">
                            <t t-if="appointment.token_number">#<t t-out="appointment.token_number"/></t>
                            <t t-else="">—</t>
                        </span>
                        <a t-if="appointment.state not in ('cancelled', 'completed', 'released')"
                           t-attf-href="/my/hospital/appointment/#{appointment.id}/live" class="o_av_stub_link">
                            <span class="o_av_live_dot"/> Track live
                        </a>
                    </div>
                </section>

                <div class="row g-4">
                    <div class="col-lg-8">
                        <!-- Visit details -->
                        <section class="o_av_card">
                            <header class="o_av_card_head">
                                <h2>Visit details</h2>
                                <span class="o_av_card_hint">Everything about your upcoming consultation</span>
                            </header>
                            <div class="o_av_doctor">
                                <img class="o_av_doctor_img" t-attf-src="/web/image/hospital.doctor/#{doctor.id}/image/160x160" t-att-alt="doctor.name"/>
                                <div class="o_av_doctor_info">
                                    <span class="o_av_label">Your doctor</span>
                                    <strong class="o_av_doctor_name">Dr. <t t-out="doctor.name"/></strong>
                                    <span class="o_av_doctor_meta">
                                        <t t-if="doctor.specialization" t-out="doctor.specialization.name"/>
                                        <t t-if="doctor.experience_years"> · <t t-out="doctor.experience_years"/>+ years experience</t>
                                    </span>
                                </div>
                                <a t-att-href="doctor.website_url or '/doctors'" class="o_av_doctor_link">
                                    Profile <i class="fa fa-long-arrow-right" aria-hidden="true"/>
                                </a>
                            </div>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="o_av_info o_av_info_blue">
                                        <span class="o_av_info_icon"><i class="fa fa-calendar" aria-hidden="true"/></span>
                                        <div>
                                            <span class="o_av_label">Date</span>
                                            <strong><span t-field="appointment.appointment_datetime" t-options="{'widget': 'date'}"/></strong>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="o_av_info o_av_info_violet">
                                        <span class="o_av_info_icon"><i class="fa fa-clock-o" aria-hidden="true"/></span>
                                        <div>
                                            <span class="o_av_label">Doctor hours</span>
                                            <strong t-out="doctor_hours_display or '—'"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="o_av_info o_av_info_teal">
                                        <span class="o_av_info_icon"><i class="fa fa-hospital-o" aria-hidden="true"/></span>
                                        <div>
                                            <span class="o_av_label">Branch</span>
                                            <strong t-out="appointment.branch_id.name or '-'"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="o_av_info o_av_info_green">
                                        <span class="o_av_info_icon"><i class="fa fa-credit-card" aria-hidden="true"/></span>
                                        <div>
                                            <span class="o_av_label">Payment</span>
                                            <strong><t t-call="smart_hospital_appointment.portal_appointment_payment_badge"/></strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div t-if="appointment.notes" class="o_av_notes">
                                <i class="fa fa-sticky-note-o" aria-hidden="true"/>
                                <div>
                                    <span class="o_av_label">Notes</span>
                                    <p t-field="appointment.notes"/>
                                </div>
                            </div>
                        </section>

                        <!-- Progress -->
                        <section class="o_av_card">
                            <header class="o_av_card_head">
                                <h2>Appointment progress</h2>
                                <span class="o_av_card_hint">Follow each step of your visit</span>
                            </header>
                            <div t-if="appointment.state == 'cancelled'" class="o_av_cancelled">
                                <span class="o_av_cancelled_icon"><i class="fa fa-ban" aria-hidden="true"/></span>
                                <div>
                                    <strong>This appointment was cancelled</strong>
                                    <p>Need to see a doctor? You can book a new appointment at any time.</p>
                                </div>
                                <a href="/appointment/book" class="o_appt_action_btn o_btn_primary">
                                    <i class="fa fa-plus" aria-hidden="true"/> Book again
                                </a>
                            </div>
                            <ol t-else="" class="o_av_timeline list-unstyled">
                                <t t-foreach="timeline" t-as="step">
                                    <li t-attf-class="o_av_step #{'o_done' if step_index &lt; current_step else ''} #{'o_current' if step_index == current_step else ''}">
                                        <span class="o_av_step_dot">
                                            <i t-attf-class="fa #{'fa-check' if step_index &lt; current_step else step[0]}" aria-hidden="true"/>
                                        </span>
                                        <strong t-out="step[1]"/>
                                        <small t-out="step[2]"/>
                                    </li>
                                </t>
                            </ol>
                        </section>
                    </div>

                    <aside class="col-lg-4">
                        <div class="o_av_side">
                            <section class="o_av_card o_av_actions">
                                <header class="o_av_card_head">
                                    <h2>Manage</h2>
                                </header>
                                <div class="d-grid gap-2">
                                    <a t-if="appointment._has_to_be_paid()" t-attf-href="/my/hospital/appointment/#{appointment.id}/pay" class="o_appt_action_btn o_btn_success">
                                        <i class="fa fa-credit-card" aria-hidden="true"/> Pay Now
                                    </a>
                                    <a t-if="appointment.state != 'cancelled'" t-attf-href="/my/hospital/appointment/#{appointment.id}/live" class="o_appt_action_btn o_btn_primary">
                                        <i class="fa fa-television" aria-hidden="true"/> Live Queue
                                    </a>
                                    <form t-if="appointment.state == 'draft'" t-attf-action="/my/hospital/appointment/#{appointment.id}/confirm" method="post" class="d-grid">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="o_appt_action_btn o_btn_success">
                                            <i class="fa fa-check" aria-hidden="true"/> Confirm
                                        </button>
                                    </form>
                                    <a t-if="appointment.state in ('draft', 'confirmed') and not appointment._is_payment_locked()" t-attf-href="/my/hospital/appointment/#{appointment.id}/edit" class="o_appt_action_btn o_btn_secondary">
                                        <i class="fa fa-pencil" aria-hidden="true"/> Edit appointment
                                    </a>
                                    <a t-if="appointment.state in ('completed', 'released')" t-attf-href="/my/hospital/appointment/#{appointment.id}/medicine-report" class="o_appt_action_btn o_btn_info">
                                        <i class="fa fa-file-text-o" aria-hidden="true"/> Print medicine report
                                    </a>
                                    <form t-if="appointment.state in ('draft', 'confirmed', 'in_progress') and not appointment._is_payment_locked()" t-attf-action="/my/hospital/appointment/#{appointment.id}/cancel" method="post" class="d-grid">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="o_appt_action_btn o_btn_danger_soft" onclick="return confirm('Cancel this appointment?');">
                                            <i class="fa fa-times" aria-hidden="true"/> Cancel appointment
                                        </button>
                                    </form>
                                    <a href="/my/hospital" class="o_av_back">
                                        <i class="fa fa-arrow-left" aria-hidden="true"/> Back to my appointments
                                    </a>
                                </div>
                            </section>

                            <section class="o_av_help">
                                <span class="o_av_help_icon"><i class="fa fa-headphones" aria-hidden="true"/></span>
                                <strong>Need help?</strong>
                                <p>Our patient care team is happy to help with your booking.</p>
                                <a t-if="help_company.phone" t-attf-href="tel:#{help_company.phone}" class="o_av_help_link">
                                    <i class="fa fa-phone" aria-hidden="true"/> <t t-out="help_company.phone"/>
                                </a>
                                <a t-else="" href="/contactus" class="o_av_help_link">
                                    <i class="fa fa-envelope" aria-hidden="true"/> Contact us
                                </a>
                            </section>
                        </div>
                    </aside>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_hospital_appointment_form" name="Hospital portal appointment form">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Appointment</t>
            </t>
            <div class="container pb-5 o_hospital_appointments_page">
                <div class="o_appt_form_card">
                    <div class="o_appt_form_header">
                        <h1 class="o_appt_form_title" t-if="appointment">Edit Appointment</h1>
                        <h1 class="o_appt_form_title" t-else="">Book New Appointment</h1>
                        <p class="o_appt_form_subtitle">
                            Booking as <strong t-out="portal_partner.name"/>.
                            Select your branch, specialization, doctor, date, and time.
                        </p>
                    </div>
                    <div class="o_appt_form_body">
                        <div t-if="error and error.get('message')" class="o_appt_alert" t-out="error['message']"/>
                        <form t-att-action="form_action or request.httprequest.path" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="o_appt_form_grid">
                                <div class="o_appt_form_group">
                                    <label class="form-label" for="branch_id">Branch</label>
                                    <select class="form-select" name="branch_id" id="branch_id" required="required">
                                        <option value="" disabled="disabled" t-att-selected="not selected_branch_id and 'selected' or None">Select a branch</option>
                                        <t t-foreach="branches" t-as="b">
                                            <option t-att-value="b.id" t-att-selected="'selected' if selected_branch_id == b.id else None">
                                                <t t-out="b.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="o_appt_form_group">
                                    <label class="form-label" for="specialization_id">Specialization</label>
                                    <select class="form-select" name="specialization_id" id="specialization_id" required="required" t-att-disabled="not selected_branch_id and 'disabled' or None">
                                        <option value="" disabled="disabled" t-att-selected="not selected_specialization_id and 'selected' or None">
                                            <t t-if="not selected_branch_id">Select a branch first</t>
                                            <t t-elif="not specializations">No specialization at this branch</t>
                                            <t t-else="">Select a specialization</t>
                                        </option>
                                        <t t-foreach="specializations" t-as="s">
                                            <option t-att-value="s.id" t-att-selected="'selected' if selected_specialization_id == s.id else None">
                                                <t t-out="s.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="o_appt_form_group">
                                    <label class="form-label" for="doctor_id">Doctor</label>
                                    <select class="form-select" name="doctor_id" id="doctor_id" required="required" t-att-disabled="not selected_specialization_id and 'disabled' or None">
                                        <option value="" disabled="disabled" t-att-selected="not selected_doctor_id and 'selected' or None">
                                            <t t-if="not selected_specialization_id">Select a specialization first</t>
                                            <t t-elif="not doctors">No doctor available for this branch and specialization</t>
                                            <t t-else="">Select a doctor</t>
                                        </option>
                                        <t t-foreach="doctors" t-as="d">
                                            <option t-att-value="d.id" t-att-selected="'selected' if selected_doctor_id == d.id else None">
                                                <t t-out="d.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="o_appt_form_group o_appt_form_full">
                                    <div class="row g-3 o_appt_date_hours">
                                        <div class="col-md-auto">
                                            <label class="form-label" for="appointment_date">Date</label>
                                            <div class="o_booking_calendar"
                                                 data-booking-calendar="1"
                                                 t-att-data-available-weekdays="available_weekdays_json or '[]'"
                                                 t-att-data-min-date="min_booking_date">
                                                <input type="hidden" name="appointment_date" id="appointment_date"
                                                       t-att-required="selected_doctor_id and available_weekdays and 'required' or None"
                                                       t-att-value="appointment_date_input or post.get('appointment_date') or ''"
                                                       t-att-disabled="(not selected_doctor_id or not available_weekdays) and 'disabled' or None"/>
                                                <div t-if="not selected_doctor_id" class="o_bc_empty_state">
                                                    <i class="fa fa-user-md" aria-hidden="true"/>
                                                    Select a doctor to see available dates.
                                                </div>
                                                <div t-elif="not available_weekdays" class="o_bc_empty_state">
                                                    <i class="fa fa-calendar-times-o" aria-hidden="true"/>
                                                    This doctor has no availability at the selected branch.
                                                </div>
                                                <t t-else="">
                                                    <div class="o_bc_toolbar">
                                                        <button type="button" class="o_bc_nav" data-calendar-prev="1" aria-label="Previous month">
                                                            <i class="fa fa-chevron-left" aria-hidden="true"/>
                                                        </button>
                                                        <strong data-calendar-label="1"/>
                                                        <button type="button" class="o_bc_nav" data-calendar-next="1" aria-label="Next month">
                                                            <i class="fa fa-chevron-right" aria-hidden="true"/>
                                                        </button>
                                                    </div>
                                                    <div class="o_bc_grid" data-calendar-grid="1"/>
                                                    <p class="o_bc_hint" t-if="available_weekday_labels">
                                                        <i class="fa fa-info-circle" aria-hidden="true"/>
                                                        Available:
                                                        <t t-out="', '.join(available_weekday_labels)"/>
                                                    </p>
                                                </t>
                                            </div>
                                        </div>
                                        <div t-if="appointment_time_display" class="col-md">
                                            <label class="form-label" for="appointment_time_display">Doctor hours</label>
                                            <input type="hidden" name="appointment_time" id="appointment_time"
                                                   t-att-value="appointment_time_input or ''"/>
                                            <div class="o_appt_time_display" id="appointment_time_display">
                                                <i class="fa fa-clock-o" aria-hidden="true"/>
                                                <strong t-out="appointment_time_display"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_appt_form_group o_appt_form_full">
                                    <label class="form-label" for="notes">Notes (optional)</label>
                                    <textarea class="form-control" name="notes" id="notes" rows="4"
                                              t-att-placeholder="'Any symptoms or special requests...'"
                                              t-out="appointment.notes if appointment else post.get('notes') or ''"/>
                                </div>
                            </div>
                            <div class="o_appt_form_footer">
                                <button type="submit" class="o_appt_action_btn o_btn_primary">
                                    <i class="fa fa-calendar-check-o" aria-hidden="true"/>
                                    Save Appointment
                                </button>
                                <a href="/my/hospital" class="o_appt_action_btn o_btn_secondary">Cancel</a>
                                <a href="/doctors" class="o_appt_action_btn o_btn_secondary">
                                    <i class="fa fa-user-md" aria-hidden="true"/>
                                    View Doctors
                                </a>
                            </div>
                        </form>
                            <script>
                                (function () {
                                    const branch = document.getElementById("branch_id");
                                    const spec = document.getElementById("specialization_id");
                                    const doctor = document.getElementById("doctor_id");
                                    const date = document.getElementById("appointment_date");
                                    if (!branch || !spec) return;
                                    function reloadFilters(mode) {
                                        const params = new URLSearchParams(window.location.search);
                                        params.set("branch_id", branch.value || "");
                                        if (mode === "branch") {
                                            params.delete("specialization_id");
                                            params.delete("doctor_id");
                                        } else {
                                            params.set("specialization_id", spec.value || "");
                                            if (mode === "spec") {
                                                params.delete("doctor_id");
                                            } else if (doctor &amp;&amp; doctor.value) {
                                                params.set("doctor_id", doctor.value);
                                            }
                                        }
                                        if (date &amp;&amp; date.value) params.set("appointment_date", date.value);
                                        params.delete("appointment_time");
                                        const notes = document.getElementById("notes");
                                        if (notes &amp;&amp; notes.value) params.set("notes", notes.value);
                                        window.location.search = params.toString();
                                    }
                                    branch.addEventListener("change", function () { reloadFilters("branch"); });
                                    spec.addEventListener("change", function () { reloadFilters("spec"); });
                                    if (doctor) doctor.addEventListener("change", function () { reloadFilters("doctor"); });
                                    if (date) date.addEventListener("change", function () { reloadFilters("date"); });
                                })();
                            </script>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
